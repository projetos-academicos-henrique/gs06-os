# Configuração central da infraestrutura SafeCity.
# Todos os scripts leem este arquivo. Altere aqui, não nos scripts.

# ---------- Rede / DNS ----------
HOSTNAME_SERVIDOR="safecity-srv"
DOMINIO_LOCAL="safecity.local"          # nome usado para acessar a API
DNS_SERVIDORES="1.1.1.1 8.8.8.8"         # resolvedores DNS do servidor
# IP fixo (opcional). Deixe vazio para manter o DHCP da VM.
# Ex.: IP_ESTATICO="192.168.56.10/24"  GATEWAY="192.168.56.1"  INTERFACE="enp0s8"
IP_ESTATICO=""
GATEWAY=""
INTERFACE=""

# ---------- Aplicação ----------
REPO_URL="https://github.com/AndreyRNagata/safecity-api.git"
REPO_BRANCH="main"
APP_USUARIO="safecity"
APP_PORTA="5080"
APP_DIR="/opt/safecity"                  # código-fonte e binários
DADOS_DIR="/var/lib/safecity"            # banco SQLite
LOG_DIR="/var/log/safecity"              # logs de monitoramento e auditoria

# ---------- Monitoramento ----------
INTERVALO_SEGUNDOS="10"
LIMITE_CPU="80"      # % de uso
LIMITE_MEMORIA="80"  # % de uso
LIMITE_DISCO="85"    # % de uso da partição /
